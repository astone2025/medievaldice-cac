/* roll-redirect.css */ \
/* --- REVEAL LOGIC --- */ \
/* 1. Hide all stanza containers by default */ \
.stanza-container \{\
    display: none; \
\} \
\
/* 2. Only show the container that matches the clicked button anchor (#roll-xxx) */ \
.stanza-container:target \{\
    display: block !important; \
    animation: fadeIn 0.5s; /* Smoothly fades in the result */ \
    scroll-margin-top: 100px; /* Keeps header visible after jump */ \
\} \
\
@keyframes fadeIn \{\
    from \{ opacity: 0; \} \
    to \{ opacity: 1; \} \
\} \
\
/* --- LAYOUT STYLING --- */ \
.stanza-flex \{\
    display: flex; \
    gap: 40px; \
    justify-content: space-between; \
    margin-top: 20px; \
\} \
\
.stanza-flex > div \{\
    flex: 1; /* Gives both versions equal width */ \
\} \
\
/* Typography for poem lines */ \
.middle-english p, .modern-english p \{\
    white-space: nowrap; \
    overflow-x: auto; \
    font-size: clamp(0.85rem, 3vw, 1.1rem); \
    line-height: 1.6; \
\} \
\
.roll-header \{\
    text-align: center; \
    color: #a52a2a; \
    font-size: 1.5rem; \
\} \
\
/* --- MOBILE STYLING (Stacked Layout showing both versions) --- */ \
@media only screen and (max-width: 768px) \{\
    /* Stack Middle English on top of Modern English */\
    .stanza-flex \{\
        flex-direction: column !important;\
        gap: 24px !important;\
    \}\
\
    /* Ensure both columns display fully and take full mobile width */\
    .middle-english, .modern-english \{\
        display: block !important;\
        width: 100% !important;\
    \}\
\
    /* Standardize text and strong labels alignment for mobile */\
    .middle-english strong, .modern-english strong \{\
        display: block !important;\
        margin-bottom: 8px;\
    \}\
\
    .middle-english p, .modern-english p \{\
        text-align: left !important;\
        white-space: nowrap !important; /* Prevents text from wrapping awkwardly */ \
        overflow-x: auto !important; /* Allows swiping wide lines if needed */\
        font-size: clamp(13px, 4.2vw, 16px) !important; \
        line-height: 1.8; \
    \}\
\
    .stanza-container:target \{\
        scroll-margin-top: 50px; \
    \} \
\} \
