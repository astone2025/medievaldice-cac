\f0\fs24 \cf0 /* The Dice Container */\
.dice-flex \{\
  display: flex;\
  justify-content: center;\
  gap: 20px;\
  margin: 30px auto;\
\}\
\
.die-text \{\
  font-size: 90px;\
  color: #a52a2a;\
  width: 90px;\
  height: 90px;\
  text-align: center;\
  display: inline-block;\
\}\
\
/* 1. The Shuffle Animation */\
@keyframes pip-shuffle \{\
  0% \{ content: "\uc0\u9856 "; \}\
  16% \{ content: "\uc0\u9857 "; \}\
  32% \{ content: "\uc0\u9858 "; \}\
  48% \{ content: "\uc0\u9859 "; \}\
  64% \{ content: "\uc0\u9860 "; \}\
  80% \{ content: "\uc0\u9861 "; \}\
  100% \{ content: "\uc0\u9856 "; \}\
\}\
\
/* 2. Permanent Background Shuffle (Prime number speeds) */\
.die-1::before \{ content: "\uc0\u9856 "; animation: pip-shuffle 0.13s infinite steps(1); \}\
.die-2::before \{ content: "\uc0\u9857 "; animation: pip-shuffle 0.17s infinite steps(1); \}\
.die-3::before \{ content: "\uc0\u9858 "; animation: pip-shuffle 0.23s infinite steps(1); \}\
\
/* 3. THE MAGIC: "Freeze" the dice when NOT clicking */\
/* By default, we pause the animation */\
.die-text::before \{\
  animation-play-state: paused;\
\}\
\
/* 4. TRIGGER: When button is pressed, PLAY the animation */\
.dice-btn:active + .dice-flex .die-text::before \{\
  animation-play-state: running;\
\}\
\
/* Visual feedback: make them blur slightly when rolling */\
.dice-btn:active + .dice-flex .die-text \{\
  filter: blur(1px);\
\}\
\
/* Button Styling */\
.dice-btn \{\
  display: block;\
  width: 240px;\
  margin: 20px auto;\
  padding: 15px;\
  background: #2c3e50;\
  color: white !important;\
  border-radius: 5px;\
  font-family: 'Georgia', serif;\
  font-weight: bold;\
  cursor: pointer;\
  border: none;\
  text-align: center;\
  outline: none;\
\}\
\
/* Make the jump smooth */\
html \{\
  scroll-behavior: smooth;\
\}\
\
/* Offset the landing spot so it's not hidden behind a top menu bar */\
[id^="roll-"] \{\
  scroll-margin-top: 100px; \
  padding-top: 20px;\
  border-top: 1px solid #eee;\
  margin-top: 40px;\
\}\
\
.dice-wrapper-box \{\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
\}\
\
/* Move the button to the bottom (visual order 2) */\
.dice-btn \{\
    order: 2;\
\}\
\
/* Move the dice to the top (visual order 1) */\
.dice-flex \{\
    order: 1;\
\}\
\
/* Keep the quote at the very bottom */\
.dice-wrapper-box p \{\
    order: 3;\
\}}